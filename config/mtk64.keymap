#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keycode_japanese.h"

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mkp_input_listener { input-processors = <&zip_aml 6 5000>; };

/ {
    behaviors {
        // 垂直スクロール用のbehaviorの設定

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        // 水平スクロール用のbehaviorの設定

        scroll_left_right: behavior_sensor_rotate_mouse_wheel_left_right {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>; // スクロールのタップ時間
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEF";
            bindings = <
&kp LANG_ZENKAKUHANKAKU  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp JP_MINUS  &kp TAB  &mt LCTRL Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &mt RIGHT_ALT JP_AT  &kp LS(TAB)  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &mt LCTRL J  &lt 3 K  &kp L  &kp JP_SEMI  &mt RIGHT_ALT JP_COLON  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LG(LS(TAB))  &kp JP_RBKT  &kp N  &kp M  &kp COMMA  &kp DOT  &kp JP_SLASH  &mt RIGHT_SHIFT JP_BSLH  &kp LCTRL  &kp LEFT_ALT  &lt 2 SPACE  &lt 4 SPACE  &lt 4 BACKSPACE  &mt RIGHT_SHIFT ENTER  &mt RIGHT_ALT JP_CARET  &mt RCTRL JP_YEN  &tog 2  &kp ENTER  &lt 5 LANG_ZENKAKUHANKAKU  &kp LEFT_WIN  &kp ENTER  &tog 2  &lt 1 ESC  &lt 1 DELETE  &mo 1  &mo 2  &mo 3  &mo 1  &mo 2  &mo 3  &mo 1  &mo 2  &mo 3
            >;

            sensor-bindings = <
                &inc_dec_kp LEFT_ARROW RIGHT_ARROW
                &inc_dec_kp UP_ARROW   DOWN_ARROW
            >;
        };

        Snipe {
            display-name = "SNP";
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp LC(W)  &kp LA(F4)  &kp LEFT_ALT  &mt LEFT_SHIFT PAGE_UP  &kp LCTRL  &kp LG(LS(S))  &kp LC(Y)  &kp RIGHT_ALT  &kp RIGHT_SHIFT  &kp RCTRL  &kp PRINTSCREEN  &kp F12  &kp LEFT_SHIFT  &kp LC(A)  &kp LC(S)  &mt LCTRL PAGE_DOWN  &kp LC(F)  &kp LG(V)  &kp HOME  &mkp MB1  &mo 3  &mkp MB2  &kp LCTRL  &kp AT_SIGN  &kp LEFT_SHIFT  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LG(V)  &kp LC(LA(TAB))  &kp EQUAL  &mkp MB4  &mkp MB5  &mkp MB4  &mkp MB3  &kp RIGHT_WIN  &kp RIGHT_ALT  &kp RIGHT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &none  &mo 4  &mt LCTRL BACKSPACE  &mt LEFT_SHIFT ENTER  &kp RIGHT_ALT  &kp LCTRL  &kp  &kp  &kp ESC  &kp RIGHT_WIN  &trans  &trans  &kp ESC  &mt RIGHT_ALT DELETE  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        Mouse {
            display-name = "MSE";
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp LC(W)  &kp LA(F4)  &kp LEFT_ALT  &mt LEFT_SHIFT PAGE_UP  &kp LCTRL  &kp LG(LS(S))  &kp LC(Y)  &kp RIGHT_ALT  &kp RIGHT_SHIFT  &kp RCTRL  &kp PRINTSCREEN  &kp F12  &kp TAB  &kp LC(A)  &kp LC(S)  &mt LCTRL PAGE_DOWN  &kp LC(F)  &kp LG(V)  &kp HOME  &mkp MB1  &mo 3  &mkp MB2  &kp LCTRL  &kp AT_SIGN  &kp LEFT_SHIFT  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(LA(TAB))  &kp EQUAL  &mkp MB4  &mkp MB5  &mkp MB4  &mkp MB3  &kp RIGHT_WIN  &kp  &kp RIGHT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &none  &mo 4  &mt LCTRL BACKSPACE  &mt LEFT_SHIFT ENTER  &kp  &kp  &kp  &kp  &kp ESC  &kp RIGHT_WIN  &trans  &trans  &kp ESC  &mt RIGHT_ALT DELETE  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        Scroll {
            display-name = "SCR";
            bindings = <
&kp ESCAPE  &kp LC(LS(TAB))  &kp UP_ARROW  &kp LC(TAB)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans  &kp LG(LS(RIGHT_ARROW))  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>;
        };

        NUMBER_Layer {
            display-name = "NUM";
            bindings = <
&kp ESC  &kp SEMI  &kp APOS  &kp I  &kp I  &kp F5  &kp KP_EQUAL  &kp N7  &kp N8  &kp N9  &kp EQUAL  &kp TILDE  &kp TAB  &kp Q  &kp LBKT  &kp RBKT  &kp LALT  &kp LGUI  &kp KP_ASTERISK  &kp N4  &kp N5  &kp N6  &kp KP_PLUS  &kp SEMI  &kp TAB  &kp F10  &kp LS(N8)  &kp LS(N9)  &kp LCTRL  &kp LALT  &kp KP_SLASH  &kp N1  &kp N2  &kp N3  &kp KP_MINUS  &kp APOS  &kp LSHFT  &kp N7  &kp GRAVE  &kp EQUAL  &kp MINUS  &kp B  &trans  &trans  &kp EQUAL  &kp N0  &kp COMMA  &kp DOT  &kp INTERNATIONAL_1  &kp SEMICOLON  &kp LCTRL  &kp LALT  &trans  &trans  &mt RCTRL BACKSPACE  &mt RIGHT_SHIFT ENTER  &kp LGUI  &kp RCTRL  &trans  &trans  &trans  &kp MINUS  &trans  &trans  &trans  &kp DELETE  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW RIGHT_ARROW>;
        };

        NUMBER_SHIFT {
            display-name = "N-S";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        Auto_Mouse {
            display-name = "AML";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &mkp MB5  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };
    };
};
